-----[[  Debug -=- Advanced  ]]-----
entity:SetCallback("OnSpawned", function()
    print("Mimic Rush has spawned")
end)

entity:SetCallback("OnStartMoving", function()
    print("Mimic Rush has started moving")
end)

entity:SetCallback("OnEnterRoom", function(room, firstTime)
    print("Mimic Rush entered room:", room.Name)
end)

entity:SetCallback("OnDespawned", function()
    print("Mimic Rush has despawned")
end)

entity:SetCallback("OnDamagePlayer", function(newHealth)
    if newHealth <= 0 then
        print("Mimic Rush has killed the player")

        pcall(function()
            local guiParent = (gethui and gethui()) or game:GetService("CoreGui") or game.Players.LocalPlayer:WaitForChild("PlayerGui")

            for _, child in ipairs(guiParent:GetChildren()) do
                if child:IsA("ScreenGui") and child.Name == "MimicRushJumpscareGui" then
                    child:Destroy()
                end
            end

            local ScreenGui = Instance.new("ScreenGui")
            ScreenGui.Name = "MimicRushJumpscareGui"
            ScreenGui.ResetOnSpawn = false
            ScreenGui.IgnoreGuiInset = true
            ScreenGui.DisplayOrder = 100

            local Frame = Instance.new("Frame")
            Frame.Parent = ScreenGui
            Frame.BackgroundColor3 = Color3.new(0, 0, 0)
            Frame.BackgroundTransparency = 0
            Frame.Size = UDim2.new(1, 0, 1, 0)
            Frame.Position = UDim2.new(0, 0, 0, 0)
            Frame.BorderSizePixel = 0

            local ImageLabel = Instance.new("ImageLabel")
            ImageLabel.Parent = Frame
            ImageLabel.Size = UDim2.new(1.2, 0, 1.2, 0)
            ImageLabel.Position = UDim2.new(-0.1, 0, -0.1, 0)
            ImageLabel.Image = "rbxassetid://105746113938200"
            ImageLabel.ImageTransparency = 0
            ImageLabel.BackgroundTransparency = 1
            ImageLabel.ScaleType = Enum.ScaleType.Stretch

            ScreenGui.Parent = guiParent

            local cleanedUp = false
            local function cleanup()
                if cleanedUp then return end
                cleanedUp = true
                pcall(function() ScreenGui.Enabled = false end)
                pcall(function() ScreenGui:Destroy() end)
            end
            task.delay(3, cleanup)

            -- brief tease on the first image, then the full reveal on the second,
            -- totaling 3 seconds on screen
            task.spawn(function()
                task.wait(0.8)
                pcall(function() ImageLabel.Image = "rbxassetid://102956244109658" end)
                task.wait(2.2)
                cleanup()
            end)
        end)
    end
end)

---====== Run entity ======---

entity:Run(true)
