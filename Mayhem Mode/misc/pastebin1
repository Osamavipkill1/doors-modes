-- Mimic Rush (renamed from "Manic Rush"/"NM Rush" so it doesn't get confused with the
-- real vanilla Rush in the death-cause display). Migrated to the new spawner --
-- previous version crashed on load whenever the placeholder rbxassetid was invalid,
-- and even when it loaded, the old fork's movement never actually worked.
-- Type="Blitz" dashes toward wherever the player currently is (the framework's own
-- example calls its Blitz demo asset "BackdoorRush.rbxm" -- this is the "Rush" analog).
local Spawner = loadstring(game:HttpGet("https://raw.githubusercontent.com/Osamavipkill1/doors-modes/refs/heads/main/Mayhem%20Mode/misc/EntitySpawnerFork/VynixuSpawner.luau"))()

local entity = Spawner:Create({
    Entity = {
        Name = "Mimic Rush",
        Asset = "https://raw.githubusercontent.com/Osamavipkill1/doors-modes/refs/heads/main/Mayhem%20Mode/misc/modules/NMRush.rbxm",
        HeightOffset = 0
    },
    Lights = {
        Flicker = { Enabled = true, Duration = 2 },
        Shatter = true,
        Repair = false
    },
    Earthquake = { Enabled = false },
    CameraShake = {
        Enabled = true,
        Range = 100,
        Values = {3.5, 20, 0.1, 1}
    },
    Movement = {
        Speed = 150,
        Delay = 2,
        Reversed = false
    },
    Rebounding = {
        Enabled = false, -- one-way dash only, matches the old single-cycle Rush
        Type = "Blitz",
        Min = 1,
        Max = 1,
        Delay = 2
    },
    Damage = {
        Enabled = true,
        Range = 100,
        Amount = 125000,
        IgnoreHiding = false
    },
    Crucifixion = {
        Type = "Guiding",
        Enabled = true,
        Range = 40,
        Resist = false,
        Break = true
    },
    Death = {
        Type = "Guiding",
        Hints = {"Oh... hello.", "Not this place again...", "Nevermind that... What'd you die to?", "Oh... the fast one.", "It doesn't like to slow down, so...", "Maybe you could call it Mimic Rush?", "Anyways, I hope you don't mind trying again. It would be helpful."},
        Cause = ""
    }
})

if not entity then
    warn("[Mayhem/pastebin1] Mimic Rush failed to create -- check the NMRush.rbxm path.")
    return
end

-----[[  Debug -=- Advanced  ]]-----
entity:SetCallback("OnSpawned", function()
    print("Mimic Rush has spawned")
end)

entity:SetCallback("OnStartMoving", function()
    print("Mimic Rush has started moving")
end)

entity:SetCallback("OnEnterRoom", function(room, firstTime)
    print("Mimic Rush entered room:", room.Name)
end)

entity:SetCallback("OnDespawned", function()
    print("Mimic Rush has despawned")
end)

entity:SetCallback("OnDamagePlayer", function(newHealth)
    if newHealth <= 0 then
        print("Mimic Rush has killed the player")
    end
end)

---====== Run entity ======---

entity:Run(true)
