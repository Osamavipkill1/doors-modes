-- Mimic Ambush (renamed from "Manic Ambush"/"NM Ambush"). Migrated to the new spawner,
-- Type="Ambush" -- travels the whole map and bounces back and forth like the old
-- 6-cycle config did.
local Spawner = loadstring(game:HttpGet("https://raw.githubusercontent.com/Osamavipkill1/doors-modes/refs/heads/main/Mayhem%20Mode/misc/EntitySpawnerFork/VynixuSpawner.luau"))()

-- Ambience sound (unchanged behavior from before, just pcall-guarded since
-- Ambience_Ambush isn't guaranteed to exist in every Doors version)
pcall(function()
    local sound = game.Workspace.Ambience_Ambush:Clone()
    sound.Name = "Ambience_Ambush_NM"
    sound.PlaybackSpeed = 0.85
    sound.Volume = 10
    sound.Parent = game.Workspace
    game.ReplicatedStorage.GameData.LatestRoom.Changed:Wait()
    sound:Play()
end)

task.wait(5)

local entity = Spawner:Create({
    Entity = {
        Name = "Mimic Ambush",
        Asset = "https://raw.githubusercontent.com/Osamavipkill1/doors-modes/refs/heads/main/Mayhem%20Mode/misc/modules/NMAmbush.rbxm",
        HeightOffset = 0
    },
    Lights = {
        Flicker = { Enabled = false, Duration = 2 },
        Shatter = true,
        Repair = false
    },
    Earthquake = { Enabled = false },
    CameraShake = {
        Enabled = true,
        Range = 100,
        Values = {3.5, 20, 0.1, 1}
    },
    Movement = {
        Speed = 400,
        Delay = 2,
        Reversed = false
    },
    Rebounding = {
        Enabled = true,
        Type = "Ambush",
        Min = 6,
        Max = 6,
        Delay = 2
    },
    Damage = {
        Enabled = true,
        Range = 100,
        Amount = 125000,
        IgnoreHiding = false
    },
    Crucifixion = {
        Type = "Guiding",
        Enabled = true,
        Range = 40,
        Resist = false,
        Break = true
    },
    Death = {
        Type = "Guiding",
        Hints = {"Oh... hello.", "Not this place again...", "Nevermind that... What'd you die to?", "Oh... the sudden one.", "It doesn't give much warning, so...", "Maybe you could call it Mimic Ambush?", "Anyways, I hope you don't mind trying again. It would be helpful."},
        Cause = ""
    }
})

if not entity then
    warn("[Mayhem/pastebin2] Mimic Ambush failed to create -- check the NMAmbush.rbxm path.")
    return
end

-----[[  Debug -=- Advanced  ]]-----
entity:SetCallback("OnSpawned", function()
    print("Mimic Ambush has spawned")
end)

entity:SetCallback("OnStartMoving", function()
    print("Mimic Ambush has started moving")
end)

entity:SetCallback("OnEnterRoom", function(room, firstTime)
    print("Mimic Ambush entered room:", room.Name)
end)

entity:SetCallback("OnDespawned", function()
    print("Mimic Ambush has despawned")
end)

entity:SetCallback("OnDamagePlayer", function(newHealth)
    if newHealth <= 0 then
        print("Mimic Ambush has killed the player")
    end
end)

---====== Run entity ======---

entity:Run(true)
