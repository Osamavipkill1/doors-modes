local Spawner = loadstring(game:HttpGet("https://raw.githubusercontent.com/Osamavipkill1/doors-modes/refs/heads/main/Mayhem%20Mode/misc/EntitySpawnerFork/Source.lua"))()

-- FIX: was an unguarded game.Workspace.Ambience_Ambush:Clone() -- if that object doesn't
-- exist in the current Doors version this throws immediately and NOTHING below it ever
-- runs (the entity never even attempts to spawn). Wrapped in pcall so a missing/renamed
-- ambience sound can't take down the whole entity.
pcall(function()
    local sound = game.Workspace.Ambience_Ambush:Clone()
    sound.Name = "Ambience_Ambush_NM"
    sound.PlaybackSpeed = 0.85
    sound.Volume = 10
    sound.Parent = game.Workspace
    game.ReplicatedStorage.GameData.LatestRoom.Changed:Wait()
    sound:Play()
end)

task.wait(5)

-- Create entity
local entityTable = Spawner.createEntity({
    CustomName = "Manic Ambush", -- Custom name of your entity
    Model = "https://raw.githubusercontent.com/Osamavipkill1/doors-modes/refs/heads/main/Mayhem%20Mode/misc/modules/NMAmbush.rbxm",
    Speed = 400, -- Percentage, 100 = default Rush speed
    DelayTime = 2, -- Time before starting cycles (seconds)
    HeightOffset = 0,
    CanKill = true,
    KillRange = 100,
    BackwardsMovement = false,
    BreakLights = true,
    FlickerLights = {
        false, -- Enabled/Disabled
        2, -- Time (seconds)
    },
    Cycles = {
        Min = 6,
        Max = 6,
        WaitTime = 2,
    },
    CamShake = {
        true, -- Enabled/Disabled
        {3.5, 20, 0.1, 1}, -- Shake values (don't change if you don't know)
        100, -- Shake start distance (from Entity to you)
    },
    Jumpscare = {
        false, -- Enabled/Disabled
        {
            -- FIX: texture ids, swapped in for consistency with the rest of the mod
            Image1 = "rbxassetid://136212819987673", -- Image1 url
            Image2 = "rbxassetid://77350187016650", -- Image2 url
            Shake = true,
            Sound1 = {
                10483790459, -- SoundId
                { Volume = 0.5 }, -- Sound properties
            },
            Sound2 = {
                10483837590, -- SoundId
                { Volume = 0.5 }, -- Sound properties
            },
            Flashing = {
                true, -- Enabled/Disabled
                Color3.fromRGB(255, 255, 255), -- Color
            },
            Tease = {
                true, -- Enabled/Disabled
                Min = 1,
                Max = 3,
            },
        },
    },
    CustomDialog = {"Oh... hello.", "Not this place again...", "Nevermind that... What'd you die to?", "Oh... the sudden one.", "It doesn't give much warning, so...", "Maybe you could call it Manic Ambush?", "Anyways, I hope you don't mind trying again. It would be helpful."},
    Color = "Yellow",
})

-- FIX: guard against Model loading failure instead of crashing on the next line
if not entityTable then
    warn("[Mayhem/pastebin2] Manic Ambush failed to create -- see the createEntity warning above for why.")
    return
end

-----[[  Debug -=- Advanced  ]]-----
entityTable.Debug.OnEntitySpawned = function()
    print("Entity has spawned:", entityTable)
end

entityTable.Debug.OnEntityDespawned = function()
    print("Entity has despawned:", entityTable)
end

entityTable.Debug.OnEntityStartMoving = function()
    print("Entity has started moving:", entityTable)
end

entityTable.Debug.OnEntityFinishedRebound = function()
    print("Entity has finished rebound:", entityTable)
end

entityTable.Debug.OnEntityEnteredRoom = function(room)
    print("Entity:", entityTable, "has entered room:", room)
end

entityTable.Debug.OnLookAtEntity = function()
    print("Player has looked at entity:", entityTable)
end

entityTable.Debug.OnDeath = function()
    warn("Player has died.")
    pcall(function() SetDeathCause("Manic Ambush") end)
end
------------------------------------

-- Run the created entity
Spawner.runEntity(entityTable)
